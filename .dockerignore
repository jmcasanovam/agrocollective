# Ignore dependency directories
**/node_modules
frontend/node_modules

# Ignore build outputs
**/.next
frontend/.next
**/dist
**/build
**/out

# Ignore local environment files and settings
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local

# Ignore version control and IDE files
**/.git
**/.gitignore
**/.gitattributes
**/.github
**/.vscode
**/.idea
**/.project
**/.classpath
**/.settings

# Ignore virtual environments
**/.venv
**/venv
**/env
**/__pycache__
**/*.pyc
**/*.pyo
**/*.pyd

# Other files
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/.pnpm-debug.log*
