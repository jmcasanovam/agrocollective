# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agrocollective
POSTGRES_USER=agro
POSTGRES_PASSWORD=aGr01

# InfluxDB
INFLUXDB_HOST=localhost
INFLUXDB_PORT=8086
# Usuario y contraseña del admin inicial (solo se aplican la primera vez que se crea el volumen de InfluxDB)
INFLUXDB_INIT_USERNAME=admin
INFLUXDB_INIT_PASSWORD=admin_password_123
# Para obtener el token: http://localhost:8086 -->  Load Data --> API Tokens --> Generate All Access Token.
INFLUXDB_TOKEN=
INFLUXDB_ORG=agrocollective
INFLUXDB_BUCKET=agrocollective

# MQTT
MQTT_HOST=localhost
MQTT_PORT=1883

# JWT
JWT_SECRET_KEY=

# API SiAR (token permanente, obtenido en la web del MAPA)
# https://servicio.mapa.gob.es/siarapi
SIAR_TOKEN=

# Procesamiento inteligente (Fases 3-10)
# Ventana de días hacia atrás para calcular variables agregadas por parcela
AGGREGATION_WINDOW_DAYS=30
# Hora (UTC, formato HH) a la que se ejecuta el proceso nocturno de clustering
CLUSTERING_SCHEDULE_HOUR=2
# Número máximo de clusters K-Means (se reduce automáticamente si hay menos parcelas)
KMEANS_MAX_CLUSTERS=5
# Vecinos para LOF; se reduce si el cluster tiene menos miembros
LOF_N_NEIGHBORS=5
# Umbral de score LOF a partir del cual una parcela se considera anómala
LOF_THRESHOLD=1.5
# Mínimo de semanas con datos para calcular correlación causal
CAUSAL_MIN_PERIODS=4
# Correlación de Pearson mínima (valor absoluto) para considerar relación causal
CAUSAL_MIN_CORR=0.6
# Número de parcelas análogas a guardar por parcela (por similitud de features)
ANALOGUE_TOP_N=5
# Predicción ML (Fase 8)
# Mínimo de parcelas con target no nulo para entrenar el modelo
ML_MIN_SAMPLES=10
# Número de árboles del Random Forest
ML_N_ESTIMATORS=100
