    ["esp:34",    "soil1:AOUT", "green",  ["h-140", "v-120"]],

    ["soil1:VCC", "bmp1:VCC", "red",   ["v210"]],
    ["soil1:GND", "bmp1:GND", "black", ["v190"]],
    ["esp:D22",   "bmp1:SCL", "blue",   ["h-90", "v100"]],
